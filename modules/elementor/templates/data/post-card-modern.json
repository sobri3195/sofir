{
  "content": [
    {
      "id": "card-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 400},
        "background_background": "classic",
        "background_color": "#ffffff",
        "border_border": "solid",
        "border_width": {"unit": "px", "top": 1, "right": 1, "bottom": 1, "left": 1},
        "border_color": "#e5e7eb",
        "border_radius": {"unit": "px", "top": 16, "right": 16, "bottom": 16, "left": 16},
        "box_shadow_box_shadow_type": "yes",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 4,
          "blur": 20,
          "spread": 0,
          "color": "rgba(0,0,0,0.08)"
        },
        "padding": {"unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0}
      },
      "elements": [
        {
          "id": "card-column",
          "elType": "column",
          "settings": {"_column_size": 100, "padding": {"unit": "px", "top": 0, "right": 0, "bottom": 0, "left": 0}},
          "elements": [
            {
              "id": "featured-image",
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {"url": "https://placehold.co/800x500/667eea/ffffff?text=Featured+Image"},
                "image_size": "large",
                "border_radius": {"unit": "px", "top": 16, "right": 16, "bottom": 0, "left": 0},
                "hover_animation": "zoom-in"
              }
            },
            {
              "id": "card-content",
              "elType": "section",
              "settings": {
                "padding": {"unit": "px", "top": 30, "right": 30, "bottom": 30, "left": 30}
              },
              "elements": [
                {
                  "id": "content-column",
                  "elType": "column",
                  "settings": {"_column_size": 100},
                  "elements": [
                    {
                      "id": "post-category",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<span style='background: #eef2ff; color: #667eea; padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;'>Technology</span>",
                        "typography_typography": "custom"
                      }
                    },
                    {
                      "id": "post-title",
                      "elType": "widget",
                      "widgetType": "heading",
                      "settings": {
                        "title": "10 Essential Tips for Modern Web Design in 2024",
                        "header_size": "h3",
                        "title_color": "#1f2937",
                        "typography_typography": "custom",
                        "typography_font_size": {"unit": "px", "size": 24},
                        "typography_font_weight": "700",
                        "typography_line_height": {"unit": "em", "size": 1.3}
                      }
                    },
                    {
                      "id": "post-excerpt",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "Discover the latest web design trends and best practices that will help you create stunning, user-friendly websites that convert visitors into customers.",
                        "text_color": "#6b7280",
                        "typography_typography": "custom",
                        "typography_font_size": {"unit": "px", "size": 16},
                        "typography_line_height": {"unit": "em", "size": 1.7}
                      }
                    },
                    {
                      "id": "post-meta",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<div style='display: flex; align-items: center; gap: 20px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb;'><img src='https://placehold.co/40x40/667eea/ffffff?text=JD' style='width: 40px; height: 40px; border-radius: 50%;' /><div><div style='color: #1f2937; font-weight: 600; font-size: 14px;'>John Doe</div><div style='color: #9ca3af; font-size: 12px;'>Dec 15, 2024 • 5 min read</div></div></div>",
                        "typography_typography": "custom"
                      }
                    },
                    {
                      "id": "read-more",
                      "elType": "widget",
                      "widgetType": "button",
                      "settings": {
                        "text": "Read More →",
                        "button_type": "default",
                        "align": "left",
                        "background_color": "transparent",
                        "button_text_color": "#667eea",
                        "typography_typography": "custom",
                        "typography_font_size": {"unit": "px", "size": 15},
                        "typography_font_weight": "600",
                        "hover_animation": "float"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
