{
  "content": [
    {
      "id": "archive-header-section",
      "elType": "section",
      "settings": {
        "background_background": "gradient",
        "background_color": "#667eea",
        "background_color_b": "#764ba2",
        "background_gradient_angle": {"unit": "deg", "size": 135},
        "padding": {"unit": "px", "top": 100, "right": 20, "bottom": 100, "left": 20}
      },
      "elements": [
        {
          "id": "archive-header-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "archive-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Our Blog",
                "header_size": "h1",
                "align": "center",
                "title_color": "#ffffff",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 56},
                "typography_font_weight": "900"
              }
            },
            {
              "id": "archive-description",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "Explore our latest articles, tutorials, and insights on web development, design, and digital marketing.",
                "align": "center",
                "text_color": "rgba(255,255,255,0.95)",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 20},
                "typography_line_height": {"unit": "em", "size": 1.6}
              }
            }
          ]
        }
      ]
    },
    {
      "id": "archive-content-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "gap": "wide",
        "padding": {"unit": "px", "top": 80, "right": 20, "bottom": 80, "left": 20}
      },
      "elements": [
        {
          "id": "posts-column",
          "elType": "column",
          "settings": {"_column_size": 66},
          "elements": [
            {
              "id": "posts-grid",
              "elType": "widget",
              "widgetType": "sofir-post-feed",
              "settings": {
                "post_type": "post",
                "posts_per_page": 9,
                "columns": 2,
                "show_image": true,
                "show_title": true,
                "show_excerpt": true,
                "show_date": true,
                "show_author": true,
                "show_categories": true,
                "image_position": "top",
                "card_style": "modern",
                "gap": {"unit": "px", "size": 30}
              }
            },
            {
              "id": "pagination",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "{{pagination}}",
                "align": "center"
              }
            }
          ]
        },
        {
          "id": "sidebar-column",
          "elType": "column",
          "settings": {"_column_size": 33},
          "elements": [
            {
              "id": "search-box",
              "elType": "widget",
              "widgetType": "sofir-search-form",
              "settings": {
                "placeholder": "Search articles...",
                "button_text": "Search",
                "show_icon": true
              }
            },
            {
              "id": "categories-widget",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Categories",
                "header_size": "h4",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 20},
                "typography_font_weight": "700"
              }
            },
            {
              "id": "categories-list",
              "elType": "widget",
              "widgetType": "sofir-term-feed",
              "settings": {
                "taxonomy": "category",
                "show_count": true,
                "orderby": "count",
                "order": "desc"
              }
            },
            {
              "id": "popular-posts-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Popular Posts",
                "header_size": "h4",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 20},
                "typography_font_weight": "700"
              }
            },
            {
              "id": "popular-posts",
              "elType": "widget",
              "widgetType": "sofir-post-feed",
              "settings": {
                "post_type": "post",
                "posts_per_page": 5,
                "orderby": "comment_count",
                "show_image": true,
                "image_size": "thumbnail",
                "show_title": true,
                "show_date": true,
                "layout": "list"
              }
            },
            {
              "id": "newsletter-widget",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border-radius: 15px; text-align: center;'><h3 style='color: #ffffff; font-size: 20px; font-weight: 700; margin-bottom: 10px;'>Newsletter</h3><p style='color: rgba(255,255,255,0.9); font-size: 14px; margin-bottom: 20px;'>Get the latest posts delivered right to your inbox.</p>[sofir_newsletter_form]</div>"
              }
            }
          ]
        }
      ]
    }
  ]
}
