{
  "content": [
    {
      "id": "post-hero-section",
      "elType": "section",
      "settings": {
        "background_background": "classic",
        "background_image": {"url": "{{featured_image_url}}"},
        "background_position": "center center",
        "background_size": "cover",
        "background_overlay_background": "gradient",
        "background_overlay_color": "rgba(0,0,0,0.6)",
        "background_overlay_color_b": "rgba(102,126,234,0.7)",
        "background_overlay_gradient_angle": {"unit": "deg", "size": 135},
        "padding": {"unit": "px", "top": 150, "right": 20, "bottom": 150, "left": 20}
      },
      "elements": [
        {
          "id": "post-hero-column",
          "elType": "column",
          "settings": {"_column_size": 100, "_content_width": {"unit": "px", "size": 800}},
          "elements": [
            {
              "id": "post-category",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "{{post_categories}}",
                "align": "center",
                "typography_typography": "custom"
              }
            },
            {
              "id": "post-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{post_title}}",
                "header_size": "h1",
                "align": "center",
                "title_color": "#ffffff",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 52},
                "typography_font_weight": "900",
                "typography_line_height": {"unit": "em", "size": 1.2}
              }
            },
            {
              "id": "post-meta",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='display: flex; align-items: center; justify-content: center; gap: 30px; color: rgba(255,255,255,0.95);'><div style='display: flex; align-items: center; gap: 10px;'><img src='{{author_avatar}}' style='width: 40px; height: 40px; border-radius: 50%;' /><span style='font-weight: 600;'>{{author_name}}</span></div><span>{{post_date}}</span><span>{{reading_time}} min read</span></div>",
                "align": "center",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 16}
              }
            }
          ]
        }
      ]
    },
    {
      "id": "post-content-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 800},
        "padding": {"unit": "px", "top": 80, "right": 20, "bottom": 80, "left": 20}
      },
      "elements": [
        {
          "id": "post-content-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "post-content",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "{{post_content}}",
                "text_color": "#374151",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 18},
                "typography_line_height": {"unit": "em", "size": 1.8}
              }
            },
            {
              "id": "post-tags",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='margin: 50px 0; padding: 30px 0; border-top: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb;'><strong style='color: #1f2937; font-size: 16px;'>Tags:</strong> {{post_tags}}</div>",
                "typography_typography": "custom"
              }
            },
            {
              "id": "social-share",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='display: flex; align-items: center; justify-content: center; gap: 15px; margin: 40px 0;'><span style='color: #6b7280; font-weight: 600;'>Share this article:</span><a href='#' style='background: #1877f2; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'><i class='fab fa-facebook-f'></i></a><a href='#' style='background: #1da1f2; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'><i class='fab fa-twitter'></i></a><a href='#' style='background: #0077b5; color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'><i class='fab fa-linkedin-in'></i></a></div>",
                "align": "center"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "author-box-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 800},
        "background_background": "classic",
        "background_color": "#f9fafb",
        "border_radius": {"unit": "px", "size": 20},
        "padding": {"unit": "px", "top": 40, "right": 40, "bottom": 40, "left": 40}
      },
      "elements": [
        {
          "id": "author-box-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "author-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "About the Author",
                "header_size": "h3",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 24},
                "typography_font_weight": "700"
              }
            },
            {
              "id": "author-info",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='display: flex; gap: 25px; align-items: flex-start;'><img src='{{author_avatar}}' style='width: 80px; height: 80px; border-radius: 50%;' /><div><h4 style='color: #1f2937; font-size: 20px; font-weight: 700; margin-bottom: 10px;'>{{author_name}}</h4><p style='color: #6b7280; font-size: 16px; line-height: 1.7; margin-bottom: 15px;'>{{author_bio}}</p><div style='display: flex; gap: 10px;'><a href='{{author_twitter}}' style='color: #667eea;'><i class='fab fa-twitter'></i></a><a href='{{author_linkedin}}' style='color: #667eea;'><i class='fab fa-linkedin'></i></a></div></div></div>",
                "typography_typography": "custom"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "related-posts-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "padding": {"unit": "px", "top": 80, "right": 20, "bottom": 80, "left": 20}
      },
      "elements": [
        {
          "id": "related-posts-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "related-posts-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Related Articles",
                "header_size": "h2",
                "align": "center",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 40},
                "typography_font_weight": "900"
              }
            },
            {
              "id": "related-posts-grid",
              "elType": "widget",
              "widgetType": "sofir-post-feed",
              "settings": {
                "post_type": "post",
                "posts_per_page": 3,
                "columns": 3,
                "related_by": "category",
                "exclude_current": true,
                "show_image": true,
                "show_title": true,
                "show_excerpt": true,
                "show_date": true,
                "card_style": "modern"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "comments-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 800},
        "padding": {"unit": "px", "top": 0, "right": 20, "bottom": 80, "left": 20}
      },
      "elements": [
        {
          "id": "comments-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "comments",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "{{comments_template}}"
              }
            }
          ]
        }
      ]
    }
  ]
}
