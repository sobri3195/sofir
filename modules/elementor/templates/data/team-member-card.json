{
  "content": [
    {
      "id": "team-card",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 320},
        "background_background": "classic",
        "background_color": "#ffffff",
        "border_radius": {"unit": "px", "top": 20, "right": 20, "bottom": 20, "left": 20},
        "box_shadow_box_shadow_type": "yes",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 8,
          "blur": 30,
          "spread": 0,
          "color": "rgba(0,0,0,0.12)"
        },
        "padding": {"unit": "px", "top": 40, "right": 30, "bottom": 40, "left": 30}
      },
      "elements": [
        {
          "id": "team-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "member-photo",
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {"url": "https://placehold.co/200x200/667eea/ffffff?text=Photo"},
                "image_size": "medium",
                "align": "center",
                "border_radius": {"unit": "%", "size": 50},
                "width": {"unit": "px", "size": 150},
                "height": {"unit": "px", "size": 150}
              }
            },
            {
              "id": "member-name",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Sarah Johnson",
                "header_size": "h3",
                "align": "center",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 22},
                "typography_font_weight": "700"
              }
            },
            {
              "id": "member-position",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Lead Designer",
                "header_size": "h5",
                "align": "center",
                "title_color": "#667eea",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "600"
              }
            },
            {
              "id": "member-bio",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "Passionate designer with 10+ years of experience creating beautiful digital experiences.",
                "align": "center",
                "text_color": "#6b7280",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 14},
                "typography_line_height": {"unit": "em", "size": 1.7}
              }
            },
            {
              "id": "social-links",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {"text": "", "icon": {"value": "fab fa-linkedin", "library": "fa-brands"}, "link": {"url": "#"}},
                  {"text": "", "icon": {"value": "fab fa-twitter", "library": "fa-brands"}, "link": {"url": "#"}},
                  {"text": "", "icon": {"value": "fab fa-github", "library": "fa-brands"}, "link": {"url": "#"}}
                ],
                "icon_align": "center",
                "icon_color": "#667eea",
                "icon_size": {"unit": "px", "size": 20},
                "space_between": {"unit": "px", "size": 15}
              }
            }
          ]
        }
      ]
    }
  ]
}
