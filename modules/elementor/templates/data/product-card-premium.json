{
  "content": [
    {
      "id": "product-card-section",
      "elType": "section",
      "settings": {
        "layout": "boxed",
        "content_width": {"unit": "px", "size": 350},
        "background_background": "classic",
        "background_color": "#ffffff",
        "border_radius": {"unit": "px", "top": 20, "right": 20, "bottom": 20, "left": 20},
        "box_shadow_box_shadow_type": "yes",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 10,
          "blur": 40,
          "spread": 0,
          "color": "rgba(0,0,0,0.1)"
        },
        "padding": {"unit": "px", "top": 25, "right": 25, "bottom": 25, "left": 25}
      },
      "elements": [
        {
          "id": "product-column",
          "elType": "column",
          "settings": {"_column_size": 100},
          "elements": [
            {
              "id": "product-badge",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<div style='position: absolute; top: 20px; right: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 8px 16px; border-radius: 25px; font-weight: 700; font-size: 12px; z-index: 10;'>NEW</div>",
                "typography_typography": "custom"
              }
            },
            {
              "id": "product-image",
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {"url": "https://placehold.co/600x600/f3f4f6/667eea?text=Product"},
                "image_size": "medium",
                "align": "center",
                "border_radius": {"unit": "px", "size": 15},
                "hover_animation": "grow"
              }
            },
            {
              "id": "product-title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Premium Wireless Headphones",
                "header_size": "h3",
                "align": "center",
                "title_color": "#1f2937",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 22},
                "typography_font_weight": "700",
                "typography_line_height": {"unit": "em", "size": 1.3}
              }
            },
            {
              "id": "product-rating",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {"text": "★★★★★", "icon": {"value": "", "library": ""}}
                ],
                "icon_align": "center",
                "icon_color": "#fbbf24",
                "text_color": "#fbbf24",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 18}
              }
            },
            {
              "id": "product-description",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "Experience premium sound quality with active noise cancellation and 30-hour battery life. Perfect for music lovers and professionals.",
                "align": "center",
                "text_color": "#6b7280",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_line_height": {"unit": "em", "size": 1.6}
              }
            },
            {
              "id": "product-price",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "$299.99",
                "header_size": "h2",
                "align": "center",
                "title_color": "#667eea",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 36},
                "typography_font_weight": "900"
              }
            },
            {
              "id": "product-features",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": [
                  {"text": "Active Noise Cancellation", "icon": {"value": "fas fa-check-circle", "library": "fa-solid"}},
                  {"text": "30-Hour Battery Life", "icon": {"value": "fas fa-check-circle", "library": "fa-solid"}},
                  {"text": "Premium Sound Quality", "icon": {"value": "fas fa-check-circle", "library": "fa-solid"}},
                  {"text": "Wireless Bluetooth 5.0", "icon": {"value": "fas fa-check-circle", "library": "fa-solid"}}
                ],
                "icon_color": "#10b981",
                "text_color": "#374151",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 14}
              }
            },
            {
              "id": "add-to-cart-button",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "Add to Cart",
                "align": "justify",
                "size": "lg",
                "background_color": "#667eea",
                "button_text_color": "#ffffff",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 18},
                "typography_font_weight": "700",
                "border_radius": {"unit": "px", "size": 12},
                "button_box_shadow_box_shadow_type": "yes",
                "button_box_shadow_box_shadow": {
                  "horizontal": 0,
                  "vertical": 8,
                  "blur": 20,
                  "spread": 0,
                  "color": "rgba(102, 126, 234, 0.4)"
                },
                "hover_animation": "pulse"
              }
            }
          ]
        }
      ]
    }
  ]
}
